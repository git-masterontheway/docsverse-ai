# DocsVerse AI Backend Configuration
PORT=5000
AI_GATEWAY_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-docsverse-local-gateway-key

# Direct LLM Provider Keys (Used for direct connection if LiteLLM is not running)
# Add your free API key here for instant cloud inference:
# 1. Groq (Recommended free fast models: https://console.groq.com)
GROQ_API_KEY=

# 2. Google AI Studio (Free Gemini 1.5 Flash: https://aistudio.google.com)
GEMINI_API_KEY=

# 3. OpenRouter (Free community models: https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# 4. OpenAI (Optional: https://platform.openai.com)
OPENAI_API_KEY=
